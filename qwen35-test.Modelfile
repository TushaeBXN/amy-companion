FROM /Users/anthosintelligence/Downloads/Qwen3.5-9B-Uncensored-HauhauCS-Aggressive-Q8_0.gguf
FROM /Users/anthosintelligence/Downloads/mmproj-Qwen3.5-9B-Uncensored-HauhauCS-Aggressive-BF16.gguf

# Qwen3.5 built-in chat renderer + tool-call parser (Ollama 0.34)
RENDERER qwen3.5
PARSER qwen3.5

# Non-thinking settings from the model card (Amy calls with think=False)
PARAMETER num_ctx      16384
PARAMETER num_batch    1024
PARAMETER num_predict  300
PARAMETER temperature  0.7
