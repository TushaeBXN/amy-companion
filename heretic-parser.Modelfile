# amy-qwen35-heretic = qwen35-heretic.Modelfile (weights, sampling, system prompt) + the Qwen3.5
# tool-call renderer/parser. That file now carries RENDERER/PARSER itself, so it builds the whole
# model in one step:  ollama create amy-qwen35-heretic -f qwen35-heretic.Modelfile
# This file is kept only to re-apply the parser to an already-built amy-qwen35-heretic.
FROM amy-qwen35-heretic:latest
RENDERER qwen3.5
PARSER qwen3.5
